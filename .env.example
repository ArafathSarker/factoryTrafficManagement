# Copy to .env to override the docker-compose defaults.

# Postgres
POSTGRES_USER=traffic
POSTGRES_PASSWORD=traffic
POSTGRES_DB=traffic
POSTGRES_PORT=5432

# Host ports
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Baked into the frontend bundle at build time. Must be reachable from the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
# auto = use the backend, fall back to the built-in simulator when unreachable.
NEXT_PUBLIC_MOCK_MODE=auto